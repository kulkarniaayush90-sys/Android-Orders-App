<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    tools:context=".MainActivity">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:background="@drawable/bg_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/my_orders"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/header_subtitle_end_margin"
        android:fontFamily="sans-serif"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="normal"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:text="@string/orders_subtitle"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/headerIllustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTitle" />

    <FrameLayout
        android:id="@+id/headerIllustration"
        android:layout_width="@dimen/header_illustration_width"
        android:layout_height="@dimen/header_illustration_height"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="@dimen/header_illustration_end_margin"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_location"
            android:tint="@color/location_dropoff" />

        <ImageView
            android:layout_width="70dp"
            android:layout_height="42dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_truck_icon"
            android:padding="7dp"
            android:src="@drawable/ic_truck"
            android:tint="@color/text_primary" />

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            android:rotation="-8"
            android:src="@drawable/ic_clipboard"
            android:tint="@color/text_primary" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_package"
            android:tint="@color/yellow_dark" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contentCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/surface_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/searchRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    style="@style/Widget.OceanOrders.SearchButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2.2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/search_hint"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/icon_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilter"
                    style="@style/Widget.OceanOrders.ActionButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="0.9"
                    android:text="@string/filter"
                    app:icon="@drawable/ic_filter"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/icon_tint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSort"
                    style="@style/Widget.OceanOrders.ActionButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="0.9"
                    android:text="@string/sort"
                    app:icon="@drawable/ic_sort"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/icon_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_tabs_container"
                android:orientation="horizontal"
                android:padding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/searchRow">

                <TextView
                    android:id="@+id/tabAll"
                    style="@style/Widget.OceanOrders.Tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/all_orders"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tabCompleted"
                    style="@style/Widget.OceanOrders.Tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/completed" />

                <TextView
                    android:id="@+id/tabCancelled"
                    style="@style/Widget.OceanOrders.Tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/cancelled" />

                <TextView
                    android:id="@+id/tabBookedAgain"
                    style="@style/Widget.OceanOrders.Tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/booked_again" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/infoBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="@color/banner_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="@color/nav_ripple"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/bannerIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_banner_icon"
                        android:padding="6dp"
                        android:src="@drawable/ic_clipboard"
                        android:tint="@color/purple_ink"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/bannerText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="3"
                        android:text="@string/info_banner"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toStartOf="@+id/bannerClose"
                        app:layout_constraintStart_toEndOf="@+id/bannerIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/bannerClose"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="2dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/icon_tint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerOrders"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/infoBanner"
                tools:itemCount="4"
                tools:listitem="@layout/item_order" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/screenContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/infoBanner" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:elevation="10dp"
        android:background="@drawable/bg_bottom_nav"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemRippleColor="@color/nav_ripple"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHelp"
        style="@style/Widget.OceanOrders.HelpButton"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="86dp"
        android:text="@string/help"
        app:icon="@drawable/ic_help"
        app:iconGravity="textTop"
        app:iconPadding="1dp"
        app:iconTint="@color/icon_tint"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
